# ==========================================
# MARS NEWS ENVIRONMENT CONFIGURATION
# ==========================================

# Application
APP_NAME="MARS NEWS"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=mars_news_production_super_secret_jwt_key_change_in_prod_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector in prod; SQLite supported for local standalone tests)
DATABASE_URL=postgresql+psycopg://mars_user:mars_password@localhost:5432/mars_news
# For standalone local run without PostgreSQL service:
# DATABASE_URL=sqlite:///./mars_news.db

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Editorial Services (OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Search Engine (Meilisearch)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=mars_master_search_key_12345

# Media Storage (Cloudflare R2 / AWS S3 / Local)
STORAGE_BACKEND=local
STORAGE_DIR=./media_uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mars-news-media
R2_ACCOUNT_ID=

# Newsroom Automation Settings
EMERGENCY_PUBLISHING_PAUSE=false
AUTO_COLLECT_INTERVAL_MINUTES=15
AUTO_PUBLISH_DELAY_MINUTES=5
FACT_VALIDATION_STRICT_MODE=true

# Initial Admin Seed
ADMIN_EMAIL=admin@marsnews.in
ADMIN_PASSWORD=MarsNewsSuperAdmin2026!
